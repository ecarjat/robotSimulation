<mujoco model="two_wheel_leg_planar">

  <!-- Units: meters, kg, seconds -->
  <compiler angle="degree" coordinate="local"/>
  <option timestep="0.001" integrator="RK4" solver="Newton" gravity="0 0 -9.81"
          iterations="100" tolerance="1e-12"/>

  <!-- Defaults: keep contact stable early -->
  <default>
    <joint damping="2.0" armature="0.02" limited="true"/>
    <geom contype="1" conaffinity="1" density="500" friction="1.2 0.1 0.01"
          solref="0.01 1" solimp="0.99 0.999 0.001" />
    <motor ctrlrange="-1 1" ctrllimited="true"/>
  </default>

  <asset>
    <!-- Optional: add meshes later for visuals only -->
  </asset>

  <worldbody>

    <!-- Ground -->
    <geom name="ground" type="plane" pos="0 0 0" size="5 5 0.1" friction="1.2 0.02 0.002"/>

    <!-- A curb (toggle contype/conaffinity to 0 to disable) -->
    <geom name="curb" type="box" pos="1.2 0 0.05" size="0.2 0.5 0.05" friction="1.2 0.02 0.002"/>

    <!-- Simple stairs: three steps (edit rise/run here) -->
    <!-- Step rise = 0.05, run = 0.20 -->
    <geom name="step1" type="box" pos="2.0 0 0.025" size="0.10 0.50 0.025"/>
    <geom name="step2" type="box" pos="2.2 0 0.075" size="0.10 0.50 0.075"/>
    <geom name="step3" type="box" pos="2.4 0 0.125" size="0.10 0.50 0.125"/>

    <!-- ============================= -->
    <!-- Robot root: full 3D floating base -->
    <!-- ============================= -->
    <body name="torso" pos="0 0 0.60">

      <!-- Free joint: x, y, z, and quaternion -->
      <joint name="base" type="free"/>

      <!-- Put real mass/inertia here once you export from CAD -->
      <inertial pos="0 0 0" mass="600.0" diaginertia="10.00 10.00 10.00"/>

      <!-- Optional torso collision (keep simple) -->
      <geom name="torso_geom" type="box" pos="0 0 0.10" size="0.15 0.05 0.08" contype="1" conaffinity="1"/>

      <!-- Reference sites on torso (track width = 0.310 m) -->
      <site name="H_L"  pos="0.00000  0.15500 0.00000" size="0.006" rgba="0 0 0 1"/>
      <site name="H_R"  pos="0.00000 -0.15500 0.00000" size="0.006" rgba="0 0 0 1"/>
      <site name="Bc_L" pos="0.09893  0.15500 0.11576" size="0.006" rgba="1 0 0 1"/>
      <site name="Bc_R" pos="0.09893 -0.15500 0.11576" size="0.006" rgba="1 0 0 1"/>

      <!-- IMU site (you can move it to match your real IMU location) -->
      <site name="imu" pos="0 0 0.12" size="0.006"/>

      <!-- ============================= -->
      <!-- Left linkage (Y+): H_L -> K_L -> W_L / C_L -->
      <!-- ============================= -->
      <body name="left_leg" pos="0 0.155 0">

        <body name="upper_L" pos="0 0 0">
          <joint name="hip_L" type="hinge" axis="0 1 0" range="23.95 61.04"/>
          <inertial pos="0.18 0 0" mass="100.0" diaginertia="2.50 2.50 0.50"/>

          <site name="K_L" pos="0.39609 0 0" size="0.006" rgba="0 0 1 1"/>
          <geom name="upper_capsule_L" type="capsule"
                fromto="0 0 0   0.39609 0 0" size="0.016"/>

          <body name="lower_L" pos="0.39609 0 0">
            <joint name="knee_L" type="hinge" axis="0 1 0" range="-121.6 -41.73"/>
            <inertial pos="0.19 0 0" mass="80.0" diaginertia="1.20 1.20 0.30"/>

            <site name="W_L" pos="-0.37996 0 0" size="0.006" rgba="0.6 0.6 0.6 1"/>
            <site name="C_L" pos=" 0.07506 0 0" size="0.006" rgba="0 1 0 1"/>

            <geom name="lower_capsule_L" type="capsule"
                  fromto="-0.37996 0 0   0.07506 0 0" size="0.016"/>

            <!-- Rod link: C_L -> Bc_L (C is a real joint now) -->
            <body name="rod_L" pos="0.07506 0 0">
              <joint name="C_L" type="hinge" axis="0 1 0" range="-180 0"/>
              <site name="rod_tip_L" pos="0.41762 0 0" size="0.006"/>
              <geom name="rod_capsule_L" type="capsule"
                    fromto="0 0 0   0.41762 0 0" size="0.010"/>
            </body>

            <body name="wheel_L" pos="-0.37996 0 0">
              <joint name="wheel_L" type="hinge" axis="0 1 0" range="-100000 100000"/>
              <geom name="wheel_geom_L" type="cylinder"
                    size="0.085 0.03"
                    euler="90 0 0"
                    friction="1.4 0.02 0.002"
                    density="300"/>
            </body>
          </body>
        </body>
      </body>

      <!-- ============================= -->
      <!-- Right linkage (Y-): H_R -> K_R -> W_R / C_R -->
      <!-- ============================= -->
      <body name="right_leg" pos="0 -0.155 0">

        <body name="upper_R" pos="0 0 0">
          <joint name="hip_R" type="hinge" axis="0 1 0" range="23.95 61.04"/>
          <inertial pos="0.18 0 0" mass="100.0" diaginertia="2.50 2.50 0.50"/>

          <site name="K_R" pos="0.39609 0 0" size="0.006" rgba="0 0 1 1"/>
          <geom name="upper_capsule_R" type="capsule"
                fromto="0 0 0   0.39609 0 0" size="0.016"/>

          <body name="lower_R" pos="0.39609 0 0">
            <joint name="knee_R" type="hinge" axis="0 1 0" range="-121.6 -41.73"/>
            <inertial pos="0.19 0 0" mass="80.0" diaginertia="1.20 1.20 0.30"/>

            <site name="W_R" pos="-0.37996 0 0" size="0.006" rgba="0.6 0.6 0.6 1"/>
            <site name="C_R" pos=" 0.07506 0 0" size="0.006" rgba="0 1 0 1"/>

            <geom name="lower_capsule_R" type="capsule"
                  fromto="-0.37996 0 0   0.07506 0 0" size="0.016"/>

            <!-- Rod link: C_R -> Bc_R (C is a real joint now) -->
            <body name="rod_R" pos="0.07506 0 0">
              <joint name="C_R" type="hinge" axis="0 1 0" range="-180 0"/>
              <site name="rod_tip_R" pos="0.41762 0 0" size="0.006"/>
              <geom name="rod_capsule_R" type="capsule"
                    fromto="0 0 0   0.41762 0 0" size="0.010"/>
            </body>

            <body name="wheel_R" pos="-0.37996 0 0">
              <joint name="wheel_R" type="hinge" axis="0 1 0" range="-100000 100000"/>
              <geom name="wheel_geom_R" type="cylinder"
                    size="0.085 0.03"
                    euler="90 0 0"
                    friction="1.4 0.02 0.002"
                    density="300"/>
            </body>
          </body>
        </body>
      </body>

    </body>
  </worldbody>

  <!-- Close the kinematic loops: rod ends coincide with torso Bc points -->
<equality>
  <connect name="loop_BcC_L" site1="rod_tip_L" site2="Bc_L"
           solref="0.0005 1" solimp="0.99 0.999 0.001"/>
  <connect name="loop_BcC_R" site1="rod_tip_R" site2="Bc_R"
           solref="0.0005 1" solimp="0.99 0.999 0.001"/>
</equality>

  <!-- Actuators: hip position servo + wheel torque motor -->
  <actuator>
    <!-- Hip ctrl is target angle (degrees in XML, radians at runtime) -->
    <position name="act_hip_L" joint="hip_L" kp="10" kv="1"
              ctrllimited="true" ctrlrange="23.95 61.04"/>
    <motor name="act_wheel_L" joint="wheel_L" gear="25"/>
    <position name="act_hip_R" joint="hip_R" kp="10" kv="1"
              ctrllimited="true" ctrlrange="23.95 61.04"/>
    <motor name="act_wheel_R" joint="wheel_R" gear="25"/>
    <!-- If knee is actuated, enable this -->
    <!-- <motor name="act_knee_L" joint="knee_L" gear="40"/> -->
    <!-- <motor name="act_knee_R" joint="knee_R" gear="40"/> -->
  </actuator>

  <!-- Sensors (optional but useful) -->
  <sensor>
    <gyro name="gyro" site="imu"/>
    <accelerometer name="acc" site="imu"/>
    <jointpos name="q_hip_L" joint="hip_L"/>
    <jointvel name="qd_hip_L" joint="hip_L"/>
    <jointpos name="q_knee_L" joint="knee_L"/>
    <jointvel name="qd_knee_L" joint="knee_L"/>
    <jointpos name="q_wheel_L" joint="wheel_L"/>
    <jointvel name="qd_wheel_L" joint="wheel_L"/>
    <jointpos name="q_C_L" joint="C_L"/>
    <jointvel name="qd_C_L" joint="C_L"/>

    <jointpos name="q_hip_R" joint="hip_R"/>
    <jointvel name="qd_hip_R" joint="hip_R"/>
    <jointpos name="q_knee_R" joint="knee_R"/>
    <jointvel name="qd_knee_R" joint="knee_R"/>
    <jointpos name="q_wheel_R" joint="wheel_R"/>
    <jointvel name="qd_wheel_R" joint="wheel_R"/>
    <jointpos name="q_C_R" joint="C_R"/>
    <jointvel name="qd_C_R" joint="C_R"/>
  </sensor>

  <!-- Initial pose: hip/rod angles chosen to satisfy the rod length for HC=0.32103 -->
<keyframe>
  <!-- qpos order: base (7) hip_L knee_L C_L wheel_L hip_R knee_R C_R wheel_R -->
  <key name="r0"
       qpos="0 0 0.37438  1 0 0 0   23.9507 -43.7348 -123.2482 0   23.9507 -43.7348 -123.2482 0"/>
</keyframe>

</mujoco>

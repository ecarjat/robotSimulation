<mujoco model="robotv2_3d">
  <compiler angle="radian" coordinate="local"/>
  <option timestep="0.001" integrator="RK4" solver="Newton" gravity="0 0 -9.81"/>

  <default>
    <joint damping="1.0" armature="0.01" limited="true"/>
    <geom contype="1" conaffinity="1" density="500"
          friction="2.0 0.2 0.02" solref="0.01 1" solimp="0.95 0.99 0.001"/>
    <motor ctrlrange="-1 1" ctrllimited="true"/>
  </default>

  <visual>
    <quality shadowsize="2048"/>
    <headlight ambient="0.15 0.15 0.15" diffuse="0.6 0.6 0.6" specular="0.2 0.2 0.2"/>
    <rgba haze="1 1 1 1"/>
    <global azimuth="2.0943951024" elevation="-0.2617993878"/>
  </visual>

  <asset>
    <texture name="floor_tex" type="2d" builtin="checker"
             rgb1="0.92 0.92 0.92" rgb2="0.78 0.78 0.78"
             width="512" height="512"/>
    <material name="floor_mat" texture="floor_tex" texrepeat="6 6"
              reflectance="0.15" shininess="0.8" specular="0.2"/>
  </asset>

  <worldbody>
    <geom name="ground" type="plane" pos="0 0 0" size="5 5 0.1" material="floor_mat"
          friction="2.0 0.2 0.02" condim="3"/>

    <!-- Studio lights -->
    <light name="key" pos="2 2 2.5" dir="-1 -1 -1" diffuse="0.9 0.9 0.9" specular="0.2 0.2 0.2"/>
    <light name="fill" pos="-2 1 1.5" dir="1 -0.5 -0.5" diffuse="0.4 0.4 0.4" specular="0 0 0"/>

    <!-- Full 3D floating base -->
    <body name="torso" pos="0 0 0.4">
      <joint name="base" type="free"/>

      <inertial pos="0 0 0" mass="10" diaginertia="0.2 0.2 0.2"/>
      <geom name="torso_geom" type="box" pos="0 0 0.1" size="0.15 0.05 0.08"/>

      <!-- Reference sites (track width = 0.310 m) -->
      <site name="H_L"  pos="0.00000  0.15500 0.00000" size="0.006" rgba="0 0 0 1"/>
      <site name="H_R"  pos="0.00000 -0.15500 0.00000" size="0.006" rgba="0 0 0 1"/>
      <site name="Bc_L" pos="0.09893  0.15500 0.11576" size="0.006" rgba="1 0 0 1"/>
      <site name="Bc_R" pos="0.09893 -0.15500 0.11576" size="0.006" rgba="1 0 0 1"/>

      <!-- Left linkage (Y+): H_L -> K_L -> W_L / C_L -->
      <body name="left_leg" pos="0 0.155 0">
        <body name="upper_L" pos="0 0 0">
          <joint name="hip_L" type="hinge" axis="0 1 0" range="0.4180063559 1.0653489754"/>
          <inertial pos="0.18 0 0" mass="2" diaginertia="0.05 0.05 0.01"/>

          <site name="K_L" pos="0.39609 0 0" size="0.006" rgba="0 0 1 1"/>
          <geom name="upper_capsule_L" type="capsule"
                fromto="0 0 0  0.39609 0 0" size="0.016"/>

          <body name="lower_L" pos="0.39609 0 0">
            <joint name="knee_L" type="hinge" axis="0 1 0" range="-2.1223203704 -0.7283258969"/>
            <inertial pos="0.19 0 0" mass="1.5" diaginertia="0.03 0.03 0.008"/>

            <site name="W_L" pos="-0.37996 0 0" size="0.006" rgba="0.6 0.6 0.6 1"/>
            <site name="C_L" pos="0.07506 0 0" size="0.006" rgba="0 1 0 1"/>

            <geom name="lower_capsule_L" type="capsule"
                  fromto="-0.37996 0 0  0.07506 0 0" size="0.016"/>

            <body name="wheel_L" pos="-0.37996 0 0">
              <joint name="wheel_L" type="hinge" axis="0 1 0" range="-100000 100000"/>
              <geom name="wheel_geom_L" type="cylinder" size="0.085 0.03" euler="1.5707963268 0 0"
                    friction="2.0 0.2 0.02" condim="3"/>
            </body>
          </body>
        </body>
      </body>

      <!-- Rod link: Bc_L -> C_L -->
      <body name="rod_L" pos="0.09893 0.155 0.11576">
        <joint name="bc_L" type="hinge" axis="0 1 0" range="-3.1415926536 3.1415926536"/>
        <site name="rod_tip_L" pos="0.41762 0 0" size="0.006"/>
        <geom name="rod_capsule_L" type="capsule"
              fromto="0 0 0  0.41762 0 0" size="0.010"/>
      </body>

      <!-- Right linkage (Y-): H_R -> K_R -> W_R / C_R -->
      <body name="right_leg" pos="0 -0.155 0">
        <body name="upper_R" pos="0 0 0">
          <joint name="hip_R" type="hinge" axis="0 1 0" range="0.4180063559 1.0653489754"/>
          <inertial pos="0.18 0 0" mass="2" diaginertia="0.05 0.05 0.01"/>

          <site name="K_R" pos="0.39609 0 0" size="0.006" rgba="0 0 1 1"/>
          <geom name="upper_capsule_R" type="capsule"
                fromto="0 0 0  0.39609 0 0" size="0.016"/>

          <body name="lower_R" pos="0.39609 0 0">
            <joint name="knee_R" type="hinge" axis="0 1 0" range="-2.1223203704 -0.7283258969"/>
            <inertial pos="0.19 0 0" mass="1.5" diaginertia="0.03 0.03 0.008"/>

            <site name="W_R" pos="-0.37996 0 0" size="0.006" rgba="0.6 0.6 0.6 1"/>
            <site name="C_R" pos="0.07506 0 0" size="0.006" rgba="0 1 0 1"/>

            <geom name="lower_capsule_R" type="capsule"
                  fromto="-0.37996 0 0  0.07506 0 0" size="0.016"/>

            <body name="wheel_R" pos="-0.37996 0 0">
              <joint name="wheel_R" type="hinge" axis="0 1 0" range="-100000 100000"/>
              <geom name="wheel_geom_R" type="cylinder" size="0.085 0.03" euler="1.5707963268 0 0"
                    friction="2.0 0.2 0.02" condim="3"/>
            </body>
          </body>
        </body>
      </body>

      <!-- Rod link: Bc_R -> C_R -->
      <body name="rod_R" pos="0.09893 -0.155 0.11576">
        <joint name="bc_R" type="hinge" axis="0 1 0" range="-3.1415926536 3.1415926536"/>
        <site name="rod_tip_R" pos="0.41762 0 0" size="0.006"/>
        <geom name="rod_capsule_R" type="capsule"
              fromto="0 0 0  0.41762 0 0" size="0.010"/>
      </body>
    </body>
  </worldbody>

  <!-- Close the loops: rod tips coincide with C points on lower legs -->
  <equality>
    <connect name="loop_BcC_L" site1="rod_tip_L" site2="C_L"
             solref="0.002 1" solimp="0.95 0.99 0.001"/>
    <connect name="loop_BcC_R" site1="rod_tip_R" site2="C_R"
             solref="0.002 1" solimp="0.95 0.99 0.001"/>
  </equality>

  <actuator>
    <position name="act_hip_L" joint="hip_L" kp="200" kv="2"
              ctrllimited="true" ctrlrange="0.4180063559 1.0653489754"/>
    <motor name="act_wheel_L" joint="wheel_L" gear="25"/>
    <position name="act_hip_R" joint="hip_R" kp="200" kv="2"
              ctrllimited="true" ctrlrange="0.4180063559 1.0653489754"/>
    <motor name="act_wheel_R" joint="wheel_R" gear="25"/>
  </actuator>

  <keyframe>
    <!-- qpos order: base (7) hip_L knee_L wheel_L bc_L hip_R knee_R wheel_R bc_R -->
    <key name="r0"
         qpos="0 0 0.37438  1 0 0 0  0.777 -1.52 0 0.961  0.777 -1.52 0 0.961"
         ctrl="0.777 0 0.777 0"/>
  </keyframe>
</mujoco>

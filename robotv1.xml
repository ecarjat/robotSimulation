<mujoco model="robotv1_planar">
  <compiler angle="degree" coordinate="local"/>
  <option timestep="0.001" integrator="RK4" solver="Newton" gravity="0 0 -9.81"/>

  <default>
    <joint damping="1.0" armature="0.01" limited="true"/>
    <geom contype="1" conaffinity="1" density="500"
          friction="2.0 0.2 0.02" solref="0.01 1" solimp="0.95 0.99 0.001"/>
    <motor ctrlrange="-1 1" ctrllimited="true"/>
  </default>

  <visual>
    <quality shadowsize="2048"/>
    <headlight ambient="0.15 0.15 0.15" diffuse="0.6 0.6 0.6" specular="0.2 0.2 0.2"/>
    <rgba haze="1 1 1 1"/>
    <global azimuth="120" elevation="-15"/>
  </visual>

  <asset>
    <texture name="floor_tex" type="2d" builtin="checker"
             rgb1="0.92 0.92 0.92" rgb2="0.78 0.78 0.78"
             width="512" height="512"/>
    <material name="floor_mat" texture="floor_tex" texrepeat="6 6"
              reflectance="0.15" shininess="0.8" specular="0.2"/>
  </asset>

  <worldbody>
    <geom name="ground" type="plane" pos="0 0 0" size="5 5 0.1" material="floor_mat"
          friction="2.0 0.2 0.02" condim="3"/>

    <!-- Studio lights -->
    <light name="key" pos="2 2 2.5" dir="-1 -1 -1" diffuse="0.9 0.9 0.9" specular="0.2 0.2 0.2"/>
    <light name="fill" pos="-2 1 1.5" dir="1 -0.5 -0.5" diffuse="0.4 0.4 0.4" specular="0 0 0"/>

    <!-- Planar base: x/z slides + yaw about Y -->
    <body name="torso" pos="0 0 0.4">
      <joint name="base_x" type="slide" axis="1 0 0" range="-2 2"/>
      <joint name="base_z" type="slide" axis="0 0 1" range="0 2"/>
      <joint name="base_yaw" type="hinge" axis="0 1 0" range="-180 180"/>

      <inertial pos="0 0 0" mass="10" diaginertia="0.2 0.2 0.2"/>
      <geom name="torso_geom" type="box" pos="0 0 0.1" size="0.15 0.05 0.08"/>

      <!-- Reference sites -->
      <site name="H"  pos="0 0 0" size="0.006" rgba="0 0 0 1"/>
      <site name="Bc" pos="0.09893 0 0.11576" size="0.006" rgba="1 0 0 1"/>

      <!-- Upper leg: H -> K -->
      <body name="upper" pos="0 0 0">
        <joint name="hip" type="hinge" axis="0 1 0" range="23.95 61.04"/>
        <inertial pos="0.18 0 0" mass="2" diaginertia="0.05 0.05 0.01"/>

        <site name="K" pos="0.39609 0 0" size="0.006" rgba="0 0 1 1"/>
        <geom name="upper_capsule" type="capsule"
              fromto="0 0 0  0.39609 0 0" size="0.016"/>

        <!-- Lower leg: K -> W, with point C -->
        <body name="lower" pos="0.39609 0 0">
          <joint name="knee" type="hinge" axis="0 1 0" range="-121.6 -41.73"/>
          <inertial pos="0.19 0 0" mass="1.5" diaginertia="0.03 0.03 0.008"/>

          <site name="W" pos="-0.37996 0 0" size="0.006" rgba="0.6 0.6 0.6 1"/>
          <site name="C" pos="0.07506 0 0" size="0.006" rgba="0 1 0 1"/>

          <geom name="lower_capsule" type="capsule"
                fromto="-0.37996 0 0  0.07506 0 0" size="0.016"/>

          <body name="wheel" pos="-0.37996 0 0">
            <joint name="wheel" type="hinge" axis="0 1 0" range="-100000 100000"/>
            <geom name="wheel_geom" type="cylinder" size="0.085 0.03" euler="90 0 0"
                  friction="2.0 0.2 0.02" condim="3"/>
          </body>
        </body>
      </body>

      <!-- Rod link: Bc -> C -->
      <body name="rod" pos="0.09893 0 0.11576">
        <joint name="bc" type="hinge" axis="0 1 0" range="-180 180"/>
        <site name="rod_tip" pos="0.41762 0 0" size="0.006"/>
        <geom name="rod_capsule" type="capsule"
              fromto="0 0 0  0.41762 0 0" size="0.010"/>
      </body>
    </body>
  </worldbody>

  <!-- Close the loop: rod tip coincides with C on lower leg -->
  <equality>
    <connect name="loop_BcC" site1="rod_tip" site2="C"
             solref="0.002 1" solimp="0.95 0.99 0.001"/>
  </equality>

  <actuator>
    <motor name="act_hip" joint="hip" gear="60"/>
    <motor name="act_wheel" joint="wheel" gear="25"/>
  </actuator>

  <keyframe>
    <!-- qpos order: base_x base_z base_yaw hip knee wheel bc -->
    <key name="r0" qpos="0 0.37438 0  23.9507 -43.7348 0 -123.2482"/>
  </keyframe>
</mujoco>

<mujoco model="scene">
    <include file="robot.xml" />

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
        <rgba haze="0.15 0.25 0.35 1" />
        <global azimuth="160" elevation="-20" />
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072" />
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300" />
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2" />
        <material name="ramp_mat" rgba="0.35 0.35 0.38 1" reflectance="0.15" />
    </asset>
    <keyframe>
        <include file="keyframes_eq.xml" />
    </keyframe>

    <worldbody>
        <light pos="0 0 3.5" dir="0 0 -1" directional="true" />
        <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="groundplane"
              friction="1.2 0.03 0.001" condim="4"
              solref="0.02 2" solimp="0.90 0.97 0.001 0.5 2" priority="1" />

        <!-- Ramp: starts near x=1.5 m, rises to ~0.5 m over ~4.0 m run (gentle slope). -->
        <body name="ramp_body" pos="3.5 0 0.2004" euler="0 -0.124355 0">
            <geom name="ramp" type="box" size="2.0155 0.6 0.05" material="ramp_mat"
                  friction="1.2 0.03 0.001" condim="4"
                  solref="0.02 2" solimp="0.90 0.97 0.001 0.5 2" priority="1" />
        </body>
    </worldbody>
</mujoco>

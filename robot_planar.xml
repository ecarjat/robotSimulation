<mujoco model="two_wheel_leg_planar">

  <!-- Units: meters, kg, seconds -->
  <compiler angle="degree" coordinate="local"/>
  <option timestep="0.001" integrator="RK4" solver="Newton" gravity="0 0 -9.81"/>

  <!-- Defaults: keep contact stable early -->
  <default>
    <joint damping="0.2" armature="0.0" limited="true"/>
    <geom contype="1" conaffinity="1" density="500" friction="1.0 0.01 0.001" solref="0.003 1" solimp="0.9 0.95 0.001" />
    <motor ctrlrange="-1 1" ctrllimited="true"/>
  </default>

  <asset>
    <!-- Optional: add meshes later for visuals only -->
  </asset>

  <worldbody>

    <!-- Ground -->
    <geom name="ground" type="plane" pos="0 0 0" size="5 5 0.1" friction="1.2 0.02 0.002"/>

    <!-- A curb (toggle contype/conaffinity to 0 to disable) -->
    <geom name="curb" type="box" pos="1.2 0 0.05" size="0.2 0.5 0.05" friction="1.2 0.02 0.002"/>

    <!-- Simple stairs: three steps (edit rise/run here) -->
    <!-- Step rise = 0.05, run = 0.20 -->
    <geom name="step1" type="box" pos="2.0 0 0.025" size="0.10 0.50 0.025"/>
    <geom name="step2" type="box" pos="2.2 0 0.075" size="0.10 0.50 0.075"/>
    <geom name="step3" type="box" pos="2.4 0 0.125" size="0.10 0.50 0.125"/>

    <!-- ============================= -->
    <!-- Robot root: planar floating base -->
    <!-- ============================= -->
    <body name="torso" pos="0 0 0.60">

      <!-- Planar base: x, z, pitch (about y) -->
      <joint name="base_x" type="slide" axis="1 0 0" limited="false"/>
      <joint name="base_z" type="slide" axis="0 0 1" limited="false"/>
      <joint name="base_pitch" type="hinge" axis="0 1 0" limited="false"/>

      <!-- Put real mass/inertia here once you export from CAD -->
      <inertial pos="0 0 0" mass="6.0" diaginertia="0.10 0.10 0.10"/>

      <!-- Optional torso collision (keep simple) -->
      <geom name="torso_geom" type="box" pos="0 0 0.10" size="0.15 0.05 0.08" contype="1" conaffinity="1"/>

      <!-- Reference sites on torso -->
      <site name="H"  pos="0.00000 0 0.00000" size="0.006" rgba="0 0 0 1"/>
      <site name="Bc" pos="0.09893 0 0.11576" size="0.006" rgba="1 0 0 1"/>

      <!-- IMU site (you can move it to match your real IMU location) -->
      <site name="imu" pos="0 0 0.12" size="0.006"/>

      <!-- ============================= -->
      <!-- Upper link: rigid bar H-K -->
      <!-- ============================= -->
      <body name="upper" pos="0 0 0">

        <!-- Hip hinge -->
        <joint name="hip" type="hinge" axis="0 1 0" range="23.95 61.04"/>

        <!-- Fill these from CAD later -->
        <inertial pos="0.18 0 0" mass="2.0" diaginertia="0.05 0.05 0.01"/>

        <!-- Geometry constants (encoded directly as positions) -->
       <site name="K" pos="0.39609 0 0" size="0.006" rgba="0 0 1 1"/>

        <!-- Upper link geometry: bar H -> K -->
        <geom name="upper_capsule" type="capsule"
              fromto="0 0 0   0.39609 0 0" size="0.016"/>

        <!-- ============================= -->
        <!-- Lower bar: bar W-K-C -->
        <!-- ============================= -->
       <body name="lower" pos="0.39609 0 0">
          
          <!-- Knee hinge -->
          <joint name="knee" type="hinge" axis="0 1 0" range="-170 170"/>
          <inertial pos="0.19 0 0" mass="1.5" diaginertia="0.03 0.03 0.008"/>
          
        <!-- W - K - C are on the same rigid body; K is this body's origin -->
        <site name="W" pos="-0.37996 0 0" size="0.006" rgba="0.6 0.6 0.6 1"/>
        <site name="C" pos=" 0.07506 0 0" size="0.006" rgba="0 1 0 1"/>

        <!-- collision spanning W->C -->
        <geom name="lower_capsule" type="capsule"
              fromto="-0.37996 0 0   0.07506 0 0" size="0.016"/>

          <!-- ============================= -->
          <!-- Wheel at W -->
          <!-- ============================= -->
          <body name="wheel" pos="-0.37996 0 0">

            <joint name="wheel" type="hinge" axis="0 1 0" range="-100000 100000"/>

            <!-- IMPORTANT: replace WHEEL_RADIUS and HALF_WIDTH -->
            <!-- Cylinder axis is local z; rotate so it spins around y -->
            <geom name="wheel_geom" type="cylinder"
                  size="0.085 0.03"
                  euler="90 0 0"
                  friction="1.4 0.02 0.002"
                  density="300"/>

          </body>
        </body>
      </body>

      <!-- ============================= -->
      <!-- Rod link: Bc -> C -->
      <!-- ============================= -->
      <body name="rod" pos="0.09893 0 0.11576">
        <joint name="bc" type="hinge" axis="0 1 0" range="-180 180"/>

        <!-- BcC = 0.41762 -->
        <site name="rod_tip" pos="0.41762 0 0" size="0.006"/>
        <geom name="rod_capsule" type="capsule"
              fromto="0 0 0   0.41762 0 0" size="0.010"/>
      </body>

    </body>
  </worldbody>

  <!-- Close the kinematic loop: rod tip must coincide with point C on upper -->
<equality>
  <connect name="loop_BcC" site1="C" site2="rod_tip"
           solref="0.002 1" solimp="0.9 0.95 0.001"/>
</equality>

  <!-- Actuators: torque control (scale via gear). Replace gears with your max torques -->
  <actuator>
    <!-- ctrl = [-1,1], gear = max torque (Nm) -->
    <motor name="act_hip"   joint="hip"   gear="60"/>
    <motor name="act_wheel" joint="wheel" gear="25"/>
    <!-- If knee is actuated, enable this -->
    <!-- <motor name="act_knee" joint="knee" gear="40"/> -->
  </actuator>

  <!-- Sensors (optional but useful) -->
  <sensor>
    <gyro name="gyro" site="imu"/>
    <accelerometer name="acc" site="imu"/>
    <jointpos name="q_hip" joint="hip"/>
    <jointvel name="qd_hip" joint="hip"/>
    <jointpos name="q_knee" joint="knee"/>
    <jointvel name="qd_knee" joint="knee"/>
    <jointpos name="q_wheel" joint="wheel"/>
    <jointvel name="qd_wheel" joint="wheel"/>
  </sensor>

  <!-- Initial pose: hip/rod angles chosen to satisfy the rod length for HC=0.32103 -->
<keyframe>
  <!-- qpos order: base_x base_z base_pitch hip knee wheel bc -->

  <key name="r0"
       qpos="-0.0045 0.3744 0   -23.9507  43.8099 0  -36.9585"/>

  <key name="r25"
       qpos="-0.0062 0.4855 0   -32.1372  62.1189 0  -43.7862"/>

  <key name="r50"
       qpos="-0.0047 0.5721 0   -39.7871  77.7557 0  -50.6736"/>

  <key name="r75"
       qpos="-0.0017 0.6429 0   -46.9235  91.8695 0  -57.4557"/>

  <key name="r100"
       qpos="-0.0050 0.7625 0   -61.0409 121.6084 0  -71.8969"/>
</keyframe>

</mujoco>
